{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vault Heist: build in WSL",
            "type": "process",
            "command": "/bin/bash",
            "args": ["run.sh", "--build-only"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Vault Heist: backend tests",
            "type": "process",
            "command": "/bin/bash",
            "args": ["tests/run.sh"],
            "options": {"cwd": "${workspaceFolder}", "env": {"SANITIZE": "1", "ASAN_OPTIONS": "detect_leaks=1"}},
            "group": "test",
            "problemMatcher": ["$gcc"]
        }
    ]
}
